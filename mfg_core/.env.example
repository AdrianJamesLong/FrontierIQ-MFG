# FrontierIQ-MFG — mfg_core backend
# Copy this file to .env and fill in your values

# ── Claude — Azure AI Foundry (shared/config.py, AMPLIFYIQ_ prefix) ──────────
# Same shared Foundry deployment FrontierIQ-Energy/FrontierIQ-GxP use.
# Get the key from the "foundry-api-key" secret in the kv-amplifyiq Key
# Vault, or set AMPLIFYIQ_USE_KEY_VAULT=true (+ az login) to pull it live.
AMPLIFYIQ_FOUNDRY_API_KEY=
AMPLIFYIQ_FOUNDRY_ENDPOINT=https://adria-mok6bkgv-eastus2.services.ai.azure.com/anthropic
AMPLIFYIQ_FOUNDRY_MODEL=claude-sonnet-4-6
AMPLIFYIQ_USE_KEY_VAULT=false
AMPLIFYIQ_LOCAL_DEV=true

# Fallback only — used if AMPLIFYIQ_FOUNDRY_API_KEY is blank. Not the
# default path anymore; kept for local dev without Key Vault access.
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Microsoft Fabric — SQL Analytics Endpoint ────────────────────────────────
FABRIC_SERVER=4dnqrejc4e6ufhtysugphcd3tm-6w6zvkrxt63upcgzkjpzd2u24a.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=AmplifyIndustrial

# ── Azure AD — for Fabric authentication ─────────────────────────────────────
# Option 1: Service Principal (recommended for production)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Option 2: Leave above blank to use interactive browser login (dev only)

# ── App settings ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
